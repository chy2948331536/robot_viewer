# ============================================
# FRAMES-DATA BRANCH CONFIGURATION
# This branch only tracks frames/ directory
# ============================================

# Ignore everything by default
*

# But track the frames directory and all its contents
!frames/
!frames/**

# Track .gitignore itself
!.gitignore

# Track .git directory (needed for git to work)
!.git/

# Optional: if you want to track README or docs in this branch, uncomment:
# !README.md
# !docs/

